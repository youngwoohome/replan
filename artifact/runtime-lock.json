{
  "schema_version": 2,
  "vllm": {
    "repository": "https://github.com/vllm-project/vllm.git",
    "tag": "v0.22.0",
    "commit": "0b3ba88f165976e77ca5e6a7a3f5bba4562b80af",
    "engine": "V1",
    "observed_versions": ["0.22.0"]
  },
  "python_packages": {
    "torch": "2.11.0+cu130",
    "transformers": "5.14.1"
  },
  "execution": {
    "tensor_parallel_size": 1,
    "pipeline_parallel_size": 1,
    "primary_dtype": "float16",
    "cross_model_dtype": "bfloat16",
    "max_model_len": 8192,
    "serving_max_num_seqs": 256,
    "gpu_memory_utilization": 0.78,
    "branch_bound": 256,
    "enforce_eager": true,
    "enable_prefix_caching": true,
    "enable_chunked_prefill": true
  },
  "method": {
    "confidence_rule": "beta",
    "confidence_threshold": 0.95,
    "minimum_evidence": 4,
    "evidence_order": "sampling",
    "base_lead": "floor(branch_bound / reference_concurrency)",
    "per_parent_lead": "launched - evidence",
    "tail_boundary": "ceil(n_max / 2)",
    "refill_allocation": "equal_floor_share",
    "admission_quantum": "ceil(sqrt(branch_bound))"
  },
  "primary_metrics": [
    "bct_s",
    "mean_parent_e2e_s",
    "p95_parent_e2e_s",
    "deadline_attainment_fraction",
    "deadline_qualified_goodput_s"
  ],
  "diagnostic_metrics": [
    "accuracy",
    "parents",
    "executed_branches",
    "launched_branches",
    "aborted_branches",
    "output_tokens",
    "output_token_throughput_s",
    "maximum_observed_outstanding_branches",
    "arrival_queue_peak",
    "admission_events",
    "completed_by_deadline"
  ],
  "reported_experiments": {
    "fixed_cohort_sections": [
      "live",
      "naive",
      "midpoint",
      "order",
      "baselines",
      "allocation",
      "mixed",
      "memory",
      "branch-limit",
      "zero-slack"
    ],
    "separate_workflows": [
      "model-generalization",
      "open-loop"
    ]
  }
}
